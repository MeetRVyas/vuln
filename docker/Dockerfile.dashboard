# syntax=docker/dockerfile:1
#
# Builds the dashboard image. Used two ways (see docs/SETUP_DEPLOYMENT.md):
#   1. As the `dashboard` service in docker/docker-compose.yml (self-hosted,
#      full stack, sandbox.implementation=docker).
#   2. Directly as a Hugging Face Space's Dockerfile (sandbox.implementation
#      must be overridden to `subprocess` there -- see configs/prod.yaml).
FROM python:3.12-slim AS base

# Copying the `uv` binary from its own distroless image is faster and more
# reproducible than a curl-based install step.
COPY --from=ghcr.io/astral-sh/uv:0.11.7 /uv /uvx /usr/local/bin/

WORKDIR /app

# Install dependencies first, separately from the source, so editing
# application code doesn't invalidate this (slow) layer.
COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --no-install-project --extra dashboard --extra tracking

COPY src ./src
COPY configs ./configs
RUN uv sync --frozen --extra dashboard --extra tracking

ENV PATH="/app/.venv/bin:${PATH}" \
    VULNREM_ENV=prod \
    GRADIO_SERVER_NAME=0.0.0.0 \
    PYTHONUNBUFFERED=1

EXPOSE 7860

CMD ["python", "-m", "vulnrem.dashboard.app"]
