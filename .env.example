# Copy this file to `.env` or export these in your shell / docker-compose environment.

#  environment
VULNREM_ENV=dev # dev | prod
VULNREM_CONFIG_DIR= # optional override; defaults to ./configs

# Cloud LLM provider (Google Gemini)
# Required only when llm.active_provider (or VULNREM_LLM_PROVIDER) is "google".
GOOGLE_API_KEY=

# Local vLLM server
VLLM_BASE_URL=http://localhost:8000/v1

# Deployment-topology overrides for configs/prod.yaml
# Self-hosted docker-compose stack (default): leave both unset.
# Hugging Face Spaces: set both of these.
VULNREM_LLM_PROVIDER= # vllm | google | mock
VULNREM_SANDBOX_IMPL= # docker | subprocess

# Experiment tracking
MLFLOW_TRACKING_URI=sqlite:///mlflow.db